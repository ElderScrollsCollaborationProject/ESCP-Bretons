                    <ESCP_Pawnkind_Breton_Lion_Guard>12</ESCP_Pawnkind_Breton_Lion_Guard>
                    <ESCP_Pawnkind_Breton_Crossbowman>6</ESCP_Pawnkind_Breton_Crossbowman>
                    <ESCP_Pawnkind_Breton_Court_Mage>5</ESCP_Pawnkind_Breton_Court_Mage>
                    <ESCP_Pawnkind_Breton_Knight_Captain>2</ESCP_Pawnkind_Breton_Knight_Captain>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <ESCP_Pawnkind_Breton_Citizen>15</ESCP_Pawnkind_Breton_Citizen>
                    <ESCP_Pawnkind_Breton_Merchant>15</ESCP_Pawnkind_Breton_Merchant>
                    <ESCP_Pawnkind_Breton_Noble>8</ESCP_Pawnkind_Breton_Noble>
                    <ESCP_Pawnkind_Breton_Court_Mage>4</ESCP_Pawnkind_Breton_Court_Mage>
                </options>
            </li>
            <li>
                <kindDef>Trader</kindDef>
                <traders>
                    <ESCP_Pawnkind_Breton_Trader>1</ESCP_Pawnkind_Breton_Trader>
                    <ESCP_Pawnkind_Breton_Quartermaster>1</ESCP_Pawnkind_Breton_Quartermaster>
                </traders>
                <carriers>
                    <Muffalo>8</Muffalo>
                    <Dromedary>5</Dromedary>
                    <Alpaca>3</Alpaca>
                </carriers>
                <guards>
                    <ESCP_Pawnkind_Breton_Lion_Guard>8</ESCP_Pawnkind_Breton_Lion_Guard>
                    <ESCP_Pawnkind_Breton_Crossbowman>4</ESCP_Pawnkind_Breton_Crossbowman>
                    <ESCP_Pawnkind_Breton_Knight_Captain>1</ESCP_Pawnkind_Breton_Knight_Captain>
                </guards>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <ESCP_Pawnkind_Breton_Citizen>8</ESCP_Pawnkind_Breton_Citizen>
                    <ESCP_Pawnkind_Breton_Lion_Guard>12</ESCP_Pawnkind_Breton_Lion_Guard>
                    <ESCP_Pawnkind_Breton_Crossbowman>6</ESCP_Pawnkind_Breton_Crossbowman>
                    <ESCP_Pawnkind_Breton_Court_Mage>5</ESCP_Pawnkind_Breton_Court_Mage>
                    <ESCP_Pawnkind_Breton_Knight_Captain>2</ESCP_Pawnkind_Breton_Knight_Captain>
                    <ESCP_Pawnkind_Breton_Noble>3</ESCP_Pawnkind_Breton_Noble>
                </options>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>

        <modExtensions Inherit="False">
            <li Class="ESCP_RaceTools.FactionProperties">
                <factionTags>
                    <li>ESCP_AllFlags</li>
                </factionTags>
            </li>
            <li Class="ESCP.Factions.FactionExtension_FlavorOverride">
                <newLabel>Kingdom of Wayrest</newLabel>
            </li>
            <li Class="ESCP.Factions.FactionExtension_PermanentlyHostileTo">
                <hostileFactionDefs>
                    <li>ESCP_Faction_Kingdom_of_Daggerfall</li>
                </hostileFactionDefs>
            </li>
            <li Class="ESCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <li Class="ESCP.Factions.FactionExtension_NamedSettlement">
                <settlementNames>
                    <li>Wayrest</li>
                    <li>Evermore</li>
                    <li>Farrun</li>
                </settlementNames>
                <preferredHilliness />
                <allowedBiomes>
                    <li>TemperateForest</li>
                    <li>BorealForest</li>
                </allowedBiomes>
                <clustered>true</clustered>
                <nearFaction>ESCP_Faction_Kingdom_of_Daggerfall</nearFaction>
            </li>
            <li Class="ESCP.Enlist.FactionEnlistOptions">
                <enlistOptionsDefs>
                    <li>ESCP_Enlistment_Wayrest</li>
                </enlistOptionsDefs>
            </li>
            <li Class="ESCP.Ranks.FactionExtension_RankTracks">
                <rankTracks>
                    <li>ESCP_RankTrack_Wayrest</li>
                </rankTracks>
            </li>
            <li Class="ESCP.Core.Crime.FactionExtension_Law" />
        </modExtensions>
    </FactionDef>

</Defs>
