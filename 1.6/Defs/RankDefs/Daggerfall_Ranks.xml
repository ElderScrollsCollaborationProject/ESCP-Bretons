<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ESCP.Ranks.RankTrackDef>
        <defName>ESCP_RankTrack_Daggerfall</defName>
        <label>the court of Daggerfall ranks</label>
        <rootTier>ESCP_Rank_Daggerfall_ManAtArms</rootTier>
        <owningFaction>ESCP_Faction_Kingdom_of_Daggerfall</owningFaction>
        <collectiveNoun>the court of Daggerfall</collectiveNoun>
        <drillLabel>Tilting Practice</drillLabel>
        <drillDesc>Train with any colonist. Both stop what they are doing and both gain skill XP. Once per day.</drillDesc>
        <studyLabel>Study Heraldry</studyLabel>
        <studyDesc>Study with another member. Both gain skill XP. Once per day.</studyDesc>
        <inspectLabel>Check Their Arms</inspectLabel>
        <inspectDesc>Look over a junior member's gear. Good upkeep earns praise and poor upkeep earns a sharp word.</inspectDesc>
        <punishLabel>Send to Polish Armor...</punishLabel>
        <punishDesc>Set a junior member to tedious labor for a failure, souring their mood. Once per day per member.</punishDesc>
        <rallyLabel>For Daggerfall!</rallyLabel>
        <rallyDesc>Call on {0} to fight harder for a short while. Once every few days.</rallyDesc>
        <fallInLabel>To the Banner</fallInLabel>
        <fallInDesc>Order {0} to gather behind you, up to four deep. They hold position until released.</fallInDesc>
        <dismissLabel>Return to Your Lords</dismissLabel>
        <dismissDesc>Release {0} so they can return to their duties.</dismissDesc>
    </ESCP.Ranks.RankTrackDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_Daggerfall_ManAtArms</defName>
        <label>man-at-arms</label>
        <description>A soldier in Daggerfall's pay.</description>
        <nextTierOptions>
            <li>ESCP_Rank_Daggerfall_Squire</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_Daggerfall_Squire</defName>
        <label>squire</label>
        <description>Serves a knight and learns the way of the sword.</description>
        <minDaysInRank>4</minDaysInRank>
        <skillRequirements>
            <Melee>5</Melee>
        </skillRequirements>
        <minMissionsCompleted>1</minMissionsCompleted>
        <trainingXpPerHour>
            <Melee>400</Melee>
            <Social>200</Social>
        </trainingXpPerHour>
        <expedition>ESCP_Expedition_Faction_Novice</expedition>
        <discipline>Combat</discipline>
        <nextTierOptions>
            <li>ESCP_Rank_Daggerfall_Knight</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_Daggerfall_Knight</defName>
        <label>knight</label>
        <description>Sworn to the King of Daggerfall, with horse and arms.</description>
        <minDaysInRank>9</minDaysInRank>
        <skillRequirements>
            <Melee>8</Melee>
        </skillRequirements>
        <minMissionsCompleted>2</minMissionsCompleted>
        <trainingXpPerHour>
            <Melee>500</Melee>
            <Social>250</Social>
        </trainingXpPerHour>
        <expedition>ESCP_Expedition_Faction_Novice</expedition>
        <discipline>Combat</discipline>
        <nextTierOptions>
            <li>ESCP_Rank_Daggerfall_KnightBanneret</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_Daggerfall_KnightBanneret</defName>
        <label>knight banneret</label>
        <description>Leads knights under a banner of their own.</description>
        <minDaysInRank>14</minDaysInRank>
        <skillRequirements>
            <Melee>11</Melee>
        </skillRequirements>
        <minMissionsCompleted>4</minMissionsCompleted>
        <trainingXpPerHour>
            <Melee>600</Melee>
            <Social>300</Social>
        </trainingXpPerHour>
        <expedition>ESCP_Expedition_Faction_Veteran</expedition>
        <discipline>Combat</discipline>
        <nextTierOptions>
            <li>ESCP_Rank_Daggerfall_LordOfTheCourt</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_Daggerfall_LordOfTheCourt</defName>
        <label>lord of the court</label>
        <description>Holds lands and a voice at the king's table.</description>
        <minDaysInRank>20</minDaysInRank>
        <skillRequirements>
            <Melee>14</Melee>
        </skillRequirements>
        <minMissionsCompleted>6</minMissionsCompleted>
        <trainingXpPerHour>
            <Melee>700</Melee>
            <Social>350</Social>
        </trainingXpPerHour>
        <expedition>ESCP_Expedition_Faction_Veteran</expedition>
        <discipline>Combat</discipline>
    </ESCP.Ranks.RankTierDef>

</Defs>
